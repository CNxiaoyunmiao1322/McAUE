/* =====================================================
   McAUE 客户端样式 - 暗色版（蓝粉配色）
   各区域背景颜色 + QButtonGroup 按钮（无边框大圆角）
   ===================================================== */

/* 全局字体调大一档：默认 9pt -> 10pt */
QWidget {
    font-size: 10pt;
}

/* ---------- 主窗口卡片：深蓝底 + 圆角 ---------- */
#centralwidget {
    background-color: rgba(24, 28, 48, 240);
    border-radius: 12px;
}

/* ---------- 顶部标题栏：蓝 -> 粉渐变 ---------- */
#title_area {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3E5FCC, stop:1 #E84393);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#title {
    background: transparent;
    color: #ffffff;
    font-weight: bold;
    font-size: 17pt;
}

/* 标题栏最小化 / 关闭按钮 */
#min_button, #quit_button {
    border: none;
    background: transparent;
    color: #ffffff;
    font-size: 15px;
    min-height: 33px;
}

#min_button:hover, #quit_button:hover {
    background-color: rgba(255, 255, 255, 35);
    border-radius: 8px;
}

#quit_button:hover {
    background-color: rgba(229, 72, 77, 220);
}

/* ---------- 页面容器 ---------- */
#stackedWidget {
    background-color: transparent;
}

/* 所有子页面共用同一背景：深蓝 */
#launch, #page_2, #setting {
    background-color: rgba(30, 35, 62, 245);
}

/* 左侧登录功能区：暗粉紫 */
#function_area {
    background-color: rgba(44, 33, 70, 150);
}

/* ---------- 底部菜单栏：蓝 -> 粉渐变 ---------- */
#horizontalLayoutWidget_2 {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3E5FCC, stop:1 #E84393);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* =====================================================
   QButtonGroup 按钮：无边框 + 大圆角（半径 = 高度一半）
   ===================================================== */

/* 登录方式组（正版 / 离线 / 第三方） */
#horizontalLayoutWidget QPushButton {
    border: none;
    border-radius: 11px;            /* 按钮高度 22px，半径 = 22 / 2 */
    min-height: 22px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #3E5FCC;
    color: #ffffff;
    font-weight: bold;
}

#horizontalLayoutWidget QPushButton:checked {
    background-color: #CC1970;      /* 选中：纯色，无渐变 */
    color: #ffffff;
}

/* 底部菜单组（启动 / 下载 / 工具 / 设置 / 更多） */
#horizontalLayoutWidget_2 QPushButton {
    border: none;
    border-radius: 11px;            /* 按钮高度 22px，半径 = 22 / 2 */
    min-height: 22px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #3E5FCC;
    color: #ffffff;
    font-weight: bold;
}

#horizontalLayoutWidget_2 QPushButton:checked {
    background-color: #CC1970;      /* 选中：纯色，无渐变 */
    color: #ffffff;
}

/* ---------- 设置页 ---------- */

/* 左侧选项按钮（启动选项 / 内存分配 / 高级选项） */
#verticalLayoutWidget QPushButton {
    border: none;
    border-radius: 11px;            /* 按钮高度 22px，半径 = 22 / 2 */
    min-height: 22px;
    max-height: 22px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #3E5FCC;
    color: #ffffff;
    font-weight: bold;
}

#verticalLayoutWidget QPushButton:checked {
    background-color: #CC1970;      /* 选中：纯色，无渐变 */
    color: #ffffff;
}

/* 设置页容器与子页面 */
#setting_content_area,
#mem_option,
#pro_setting,
#launch_option_setting {
    background-color: transparent;
}

/* 设置页文字 */
#setting QLabel {
    background: transparent;
    color: #DCE4FF;
}

/* 输入框 / 文本浏览器 */
#setting QLineEdit, #jvm_para {
    border: 1px solid rgba(169, 192, 255, 80);
    border-radius: 8px;
    background-color: rgba(12, 15, 30, 190);
    color: #DCE4FF;
    padding-left: 10px;
    padding-right: 10px;
}

#setting QLineEdit:focus {
    border: 1px solid #6C8CFF;
    background-color: rgba(16, 20, 40, 220);
}

#jvm_para {
    padding: 6px;
    selection-background-color: #3E5FCC;
}

/* 下拉框 */
#setting QComboBox {
    border: 1px solid rgba(169, 192, 255, 80);
    border-radius: 8px;
    background-color: rgba(12, 15, 30, 190);
    color: #DCE4FF;
    padding-left: 10px;
    padding-right: 10px;
}

#setting QComboBox QAbstractItemView {
    border: 1px solid rgba(169, 192, 255, 120);
    border-radius: 8px;
    background-color: #1B2038;
    color: #DCE4FF;
    selection-background-color: #3E5FCC;
    selection-color: #ffffff;
    outline: none;
}

/* 内存滑块 */
#mem_slider::groove:horizontal {
    height: 8px;
    background: rgba(169, 192, 255, 50);
    border-radius: 4px;
}

#mem_slider::sub-page:horizontal {
    background: #6C8CFF;
    border-radius: 4px;
}

#mem_slider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -5px 0;
    border-radius: 9px;
    background: #DCE4FF;
    border: 2px solid #6C8CFF;
}

/* 禁用状态：明显变灰，方便区分是否可控制 */
#mem_slider::groove:horizontal:disabled {
    background: rgba(120, 120, 140, 60);
}

#mem_slider::sub-page:horizontal:disabled {
    background: rgba(120, 120, 140, 60);
}

#mem_slider::handle:horizontal:disabled {
    background: #3a3f55;
    border: 2px solid #555b75;
}

/* ---------- 启动页其他控件 ---------- */

/* 启动游戏按钮（高度 61px）：粉色主按钮 */
#launch_game_button {
    border: none;
    border-radius: 31px;
    min-height: 63px;
    background-color: #FF5C97;
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
}

#launch_game_button:hover {
    background-color: #F24C8D;
}

#launch_game_button:pressed {
    background-color: #D93E7D;
}

/* 选择版本按钮（高度 26px）：蓝色描边 */
#choose_version_button {
    border: 1px solid rgba(169, 192, 255, 150);
    border-radius: 14px;
    min-height: 28px;
    max-height: 28px;
    background-color: transparent;
    color: #A9C0FF;
}

#choose_version_button:hover {
    background-color: rgba(74, 125, 255, 35);
}

/* 用户名输入框（高度 31px） */
#username_lineEdit {
    border: 1px solid rgba(169, 192, 255, 80);
    border-radius: 8px;
    background-color: rgba(12, 15, 30, 190);
    color: #DCE4FF;
    font-size: 11pt;
    padding-left: 10px;
    padding-right: 10px;
}

#username_lineEdit:focus {
    border: 1px solid #6C8CFF;
    background-color: rgba(16, 20, 40, 220);
}
